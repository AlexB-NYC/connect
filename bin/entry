# bin/entry
#!/usr/bin/env bash
set -euo pipefail

BASE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../lib/common.sh
. "$BASE_DIR/lib/common.sh"
# shellcheck source=../lib/config.sh
. "$BASE_DIR/lib/config.sh"

usage() {
  cat <<'EOF' >&2
Usage:
  connect <servername> [--ssh | --fs] [-v|--verbose] [--insecure]
  connect --list
  connect [--add | --edit | --del]

Modes (mutually exclusive):
  --ssh           only SSH (no sshfs)
  --fs            only sshfs mount (no SSH)

Options:
  --list          list configured servers (table) and prompt for action
  -v, --verbose   verbose output (ssh -vvv, sshfs_debug)
  --insecure      disable host key checking (not recommended)

Engine:
  --add           add server entry (delegates to engine)
  --edit          edit server entry (delegates to engine)
  --del           delete server entry (delegates to engine)
EOF
  exit 1
}

server=""
mode="both"      # both|ssh|fs
verbose=0
insecure=0
do_list=0
engine_action="" # add|edit|del

while (( $# )); do
  case "$1" in
    --ssh) mode="ssh"; shift ;;
    --fs)  mode="fs";  shift ;;
    -v|--verbose) verbose=1; shift ;;
    --insecure) insecure=1; shift ;;
    --list) do_list=1; shift ;;

    --add)  engine_action="add"; shift ;;
    --edit) engine_action="edit"; shift ;;
    --del)  engine_action="del"; shift ;;

    -h|--help) usage ;;
    -* ) usage ;;
    *)
      if [[ -z "$server" ]]; then
        server="$1"; shift
      else
        usage
      fi
      ;;
  esac
done

# Delegate to engine for management functions
if [[ -n "$engine_action" ]]; then
  exec "$BASE_DIR/bin/engine" "$engine_action"
fi

CONFIG_FILE="$(resolve_config_file)"

# Ensure user config exists for interactive flows (e.g. --list).
if [[ ! -e "$CONFIG_FILE" ]]; then
  mkdir -p "$(dirname "$CONFIG_FILE")" 2>/dev/null || true
  : > "$CONFIG_FILE" 2>/dev/null || true
fi

print_list_table_and_prompt() {
  [[ -r "$CONFIG_FILE" ]] || die "Config file not readable: $CONFIG_FILE"

  local servers=()
  local hosts=()
  local users=()
  local keys=()

  local s i=0
  while IFS= read -r s; do
    [[ -n "$s" ]] || continue
    servers[i]="$s"
    users[i]="$(config_get "$CONFIG_FILE" "$s" remote_user || true)"
    hosts[i]="$(config_get "$CONFIG_FILE" "$s" remote_host || true)"
    keys[i]="$(config_get "$CONFIG_FILE" "$s" ssh_key || true)"
    i=$((i+1))
  done < <(list_servers "$CONFIG_FILE")

  local count="${#servers[@]}"
  if (( count == 0 )); then
    echo "No servers found in: $CONFIG_FILE" >&2
    echo "No servers found. Press A to add one, or run: connect --add" >&2
  fi

  local max_idx=1 max_name=4 max_host=4 max_user=4 max_key=3
  local n idx_len name_len host_len user_len key_len

  for ((i=0; i<count; i++)); do
    n=$((i+1))

    idx_len="${#n}"
    name_len="${#servers[i]}"
    host_len="${#hosts[i]}"
    user_len="${#users[i]}"
    key_len="${#keys[i]}"

    (( idx_len > max_idx )) && max_idx="$idx_len"
    (( name_len > max_name )) && max_name="$name_len"
    (( host_len > max_host )) && max_host="$host_len"
    (( user_len > max_user )) && max_user="$user_len"
    (( key_len > max_key )) && max_key="$key_len"
  done

  line() {
    local a="$1" b="$2" c="$3" d="$4" e="$5"
    printf "+-%-*s-+-%-*s-+-%-*s-+-%-*s-+-%-*s-+\n" \
      "$a" "" "$b" "" "$c" "" "$d" "" "$e" ""
  }

  line "$max_idx" "$max_name" "$max_host" "$max_user" "$max_key"
  printf "| %*s | %-*s | %-*s | %-*s | %-*s |\n" \
    "$max_idx" "#" \
    "$max_name" "name" \
    "$max_host" "host" \
    "$max_user" "user" \
    "$max_key" "key"
  line "$max_idx" "$max_name" "$max_host" "$max_user" "$max_key"

  for ((i=0; i<count; i++)); do
    n=$((i+1))
    printf "| %*d | %-*s | %-*s | %-*s | %-*s |\n" \
      "$max_idx" "$n" \
      "$max_name" "${servers[i]}" \
      "$max_host" "${hosts[i]}" \
      "$max_user" "${users[i]}" \
      "$max_key" "${keys[i]}"
  done

  line "$max_idx" "$max_name" "$max_host" "$max_user" "$max_key"
  echo >&2
  echo "Actions: [C]onnect  [A]dd  [E]dit  [D]el  [Q]uit" >&2

  local sel num selection_prompt
  selection_prompt="Enter server number"

  printf "Selection: " >&2
  IFS= read -r -n 1 sel || true
  echo >&2

  [[ -n "$sel" ]] || exit 0

  case "$sel" in
    [Qq])
      exit 0
      ;;
    [Aa])
      exec "$BASE_DIR/bin/engine" add
      ;;
    [Ee])
      num="$(prompt "[EDIT] $selection_prompt" "")"
      ;;
    [Dd])
      num="$(prompt "[DELETE] $selection_prompt" "")"
      ;;
    [Cc])
      num="$(prompt "[CONNECT] $selection_prompt" "")"
      ;;
    [0-9])
      num="$(prompt "$selection_prompt" "$sel")"
      ;;
    *)
      die "Unknown selection: $sel"
      ;;
  esac

  [[ "${num:-}" =~ ^[0-9]+$ ]] || die "Invalid number."
  (( num >= 1 && num <= count )) || die "Number out of range."

  case "$sel" in
    [Ee])
      exec "$BASE_DIR/bin/engine" edit "$num"
      ;;
    [Dd])
      exec "$BASE_DIR/bin/engine" del "$num"
      ;;
    *)
      local mode_key mode_flag
      mode_flag=""

      echo "[S]sh-only, [F]s-only, [B]oth (default)" >&2
      printf "Mode: " >&2
      IFS= read -r -n 1 mode_key || true
      echo >&2

      case "${mode_key:-}" in
        ''|[Bb]) mode_flag="" ;;
        [Ss])    mode_flag="--ssh" ;;
        [Ff])    mode_flag="--fs" ;;
        *)
          die "Unknown mode selection: $mode_key"
          ;;
      esac

      if [[ -n "$mode_flag" ]]; then
        exec "$BASE_DIR/bin/entry" "${servers[num-1]}" "$mode_flag"
      else
        exec "$BASE_DIR/bin/entry" "${servers[num-1]}"
      fi
      ;;
  esac
}

if (( do_list )); then
  print_list_table_and_prompt
  exit 0
fi

# If no server specified, drop into interactive menu
if [[ -z "$server" ]]; then
  exec "$BASE_DIR/bin/engine" menu
fi

section_exists "$CONFIG_FILE" "$server" || die "Server not found in config: [$server]"

remote_user="$(config_get "$CONFIG_FILE" "$server" remote_user)"
remote_host="$(config_get "$CONFIG_FILE" "$server" remote_host)"
remote_path="$(config_get "$CONFIG_FILE" "$server" remote_path)"
mount_label="$(config_get "$CONFIG_FILE" "$server" mount_label)"
ssh_key="$(config_get "$CONFIG_FILE" "$server" ssh_key)"
mount_point="$(config_get "$CONFIG_FILE" "$server" mount_point)"
log_file="$(config_get "$CONFIG_FILE" "$server" log_file)"

[[ -n "$remote_user" ]] || die "Missing remote_user in [$server]"
[[ -n "$remote_host" ]] || die "Missing remote_host in [$server]"
[[ -n "$remote_path" ]] || die "Missing remote_path in [$server]"
[[ -n "$mount_label" ]] || die "Missing mount_label in [$server]"

ssh_key="$(normalize_key_path "$ssh_key")"
os="$(os_family)"

if [[ -z "${mount_point:-}" ]]; then
  if [[ "$os" == "mac" ]]; then
    mount_point="$HOME/mnt/$mount_label"
  else
    mount_point="/media/$USER/$mount_label"
  fi
fi

if [[ -z "${log_file:-}" ]]; then
  log_file="${XDG_CACHE_HOME:-$HOME/.cache}/connect/connect.log"
fi

mkdir -p "$mount_point" "$(dirname "$log_file")"

log() {
  echo "[$(date +'%F %T')] $*" | tee -a "$log_file" >&2
}

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "Required command not found: $1"
}

ssh_opts=(
  -o ServerAliveInterval=60
  -o ServerAliveCountMax=3
)
if (( insecure )); then
  ssh_opts+=( -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null )
fi
if (( verbose )); then
  ssh_opts+=( -vvv )
fi
if [[ -n "$ssh_key" ]]; then
  ssh_opts=( -i "$ssh_key" "${ssh_opts[@]}" )
fi

sshfs_opts=(
  -o reconnect
  -o allow_other
  -o ServerAliveInterval=60
  -o ServerAliveCountMax=3
)
if (( insecure )); then
  sshfs_opts+=(
    -o StrictHostKeyChecking=no
    -o UserKnownHostsFile=/dev/null
  )
fi
(( verbose )) && sshfs_opts+=( -o sshfs_debug )
[[ -n "$ssh_key" ]] && sshfs_opts+=( -o IdentityFile="$ssh_key" )

unmount_mount_point() {
  if [[ "$os" == "mac" ]]; then
    umount "$mount_point" >/dev/null 2>&1 || true
  else
    if command -v fusermount >/dev/null 2>&1; then
      fusermount -u "$mount_point" >/dev/null 2>&1 || true
    else
      umount "$mount_point" >/dev/null 2>&1 || true
    fi
  fi
}

if [[ "$mode" == "ssh" ]]; then
  need_cmd ssh
  log "SSH only: $remote_user@$remote_host"
  exec ssh "${ssh_opts[@]}" "$remote_user@$remote_host"
fi

need_cmd sshfs

if [[ "$os" == "linux" ]]; then
  if [[ -f /etc/fuse.conf ]] && ! grep -q '^user_allow_other' /etc/fuse.conf; then
    die "Please uncomment 'user_allow_other' in /etc/fuse.conf (required for -o allow_other)."
  fi
fi

if [[ "$mode" == "fs" ]]; then
  log "FS only: mounting to $mount_point"
  unmount_mount_point
  log "sshfs command: sshfs ${sshfs_opts[*]} '$remote_user@$remote_host:$remote_path' '$mount_point'"
  sshfs "${sshfs_opts[@]}" "$remote_user@$remote_host:$remote_path" "$mount_point" \
    && log "Mounted." \
    || die "Mount failed."
  exit 0
fi

need_cmd ssh
log "Mounting $remote_user@$remote_host:$remote_path to $mount_point"
unmount_mount_point
log "sshfs command: sshfs ${sshfs_opts[*]} '$remote_user@$remote_host:$remote_path' '$mount_point'"

sshfs "${sshfs_opts[@]}" "$remote_user@$remote_host:$remote_path" "$mount_point" \
  && log "Mounted successfully." \
  || die "Mount failed."

log "SSH: $remote_user@$remote_host"
exec ssh "${ssh_opts[@]}" "$remote_user@$remote_host"
